# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: only needed if you do NOT install the public.username_email() helper
# from supabase/schema.sql. Bare usernames are then turned into <username>@<domain>.
# VITE_AUTH_EMAIL_DOMAIN=hive.local
